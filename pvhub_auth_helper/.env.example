# Copy this file to .env and fill in what you need.
# Required either way:
PVHUB_LOGIN_URL=https://www.pv-hub.com/login
PVHUB_PLANT_URL=https://www.pv-hub.com/v2/plants/analysis?GROUPID=YOUR_PLANT_ID
PVHUB_USERNAME=you@example.com
PVHUB_PASSWORD=yourpassword

# How often to re-capture, in seconds. 0 = run once and exit (good for
# testing before you turn on the loop).
PVHUB_LOOP_INTERVAL=1500

# --- Push mode ---
# Create a token from your HA profile page -> Security -> Long-Lived
# Access Tokens -> Create Token. Leave both blank to disable push mode.
HA_TOKEN=
PVHUB_HA_URL=http://homeassistant.local:8123
# Only needed if you have more than one PVHub plant configured in HA:
PVHUB_PLANT_ID=
PVHUB_ENTRY_ID=

# --- File mode ---
# Leave PVHUB_OUTPUT blank to disable file mode. PVHUB_SHARED_DIR controls
# where the docker-compose volume mount points on the host -- it must
# contain whatever path you set PVHUB_OUTPUT to, e.g. with the defaults
# below the file lands at ./shared/pvhub_auth.json on the host.
PVHUB_SHARED_DIR=./shared
PVHUB_OUTPUT=/shared/pvhub_auth.json

# --- Advanced (only if login/capture isn't matching your account) ---
# PVHUB_API_URL_MATCH=analysis
# PVHUB_USERNAME_SELECTOR=input[type=email], input[name*=user i], input[name*=email i]
# PVHUB_PASSWORD_SELECTOR=input[type=password]
# PVHUB_SUBMIT_SELECTOR=button[type=submit], button:has-text('Log'), button:has-text('Sign')
# PVHUB_DISMISS_SELECTOR=              # cookie/consent overlay button, if one blocks the form
# PVHUB_NAV_TIMEOUT=30000
# PVHUB_CAPTURE_TIMEOUT=25000
# PVHUB_VERBOSE=1

# Where screenshot/HTML dumps land on the host when a login step fails
# (see docker-compose.yml's volume mount). Defaults to ./debug.
# PVHUB_DEBUG_DIR_HOST=./debug

