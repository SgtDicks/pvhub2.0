# Paste the real Request URL copied from Chrome DevTools Network tab.
# This should be the PVHub API endpoint that accepted the railID/date/variables JSON payload.
PVHUB_API_URL=https://paste-the-real-request-url-from-chrome-devtools-here

# If your DevTools request uses cookie-based auth, paste the request Cookie header here.
# Do not commit or share your real .env file.
PVHUB_COOKIE=paste-your-cookie-header-here

# PVHub 2.0 may also send a custom request header named "token".
# If present in DevTools, paste that header value here.
PVHUB_TOKEN=paste-your-token-header-here

# Some PVHub 2.0 requests are signed. Copy these from the exact read-only request
# if present. They may expire quickly because Timestamp is request-time based.
PVHUB_SIGNATURE=paste-your-signature-header-here
PVHUB_TIMESTAMP=paste-your-timestamp-header-here
PVHUB_LANG=English
PVHUB_TIMEZONE=Australia/Brisbane

# Only use this if your request really has "Authorization: Bearer ...".
PVHUB_BEARER_TOKEN=

# Your plantId is the GROUPID from the PVHub page URL, and is used by
# /dew/w/plant/analysis/raw.
PVHUB_PLANT_ID=5343e453-a5dc-4bfc-ade7-5fc8b0638be2

# Optional: only needed for the older railID payload shape.
PVHUB_RAIL_ID=619ee290-5d6d-41bf-8dde-d8fc3cd09685
